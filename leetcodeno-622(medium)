class MyCircularQueue {
public:
int arr[1000];
int front, rear, size, k;
MyCircularQueue(int k) {
this->k = k;
front = 0;
rear = -1;
size = 0;
}
bool enQueue(int value) {
if (isFull()) return false;
rear = (rear + 1) % k;
arr[rear] = value;
size++;
return true;
}
bool deQueue() {
if (isEmpty()) return false;
front = (front + 1) % k;
size--;
return true;
}
int Front() {
if (isEmpty()) return -1;
return arr[front];
}
int Rear() {
if (isEmpty()) return -1;
return arr[rear];
}
bool isEmpty() {
return size == 0;
}
bool isFull() {
return size == k;
}
};
